    "shl",
    "shr",
    "sin",
    // The architecture suffix varies ("sm_90a", "sm_120a") and a target the
    // translator does not model still has to parse: the directive only tells
    // ptxas what to generate.
    r"sm_[0-9]+[a-z]?" => ShaderModel,
    "sqrt",
    "st",
    "sub",
    "texmode_independent",
    "texmode_unified",
    "trap",
    "vsub4",
    "vset4",
    "vote",
    "xor",
} else {
    // https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#identifiers
    // A lone "_" is the placeholder of a register pack ("mov.b64 {_, %r1},
    // %rd2" leaves the low half alone), so the pattern has to accept it.
    r"[a-zA-Z][a-zA-Z0-9_$]*|[_$%][a-zA-Z0-9_$]*" => ID,
    r"\.[a-zA-Z][a-zA-Z0-9_$]*" => DotID,
}


// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#memory-consistency-model-membar
InstMembar: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "membar" <scope:MemScope> => ast::Instruction::Membar(scope),
    // The instruction reports which lanes are active. A ballot over the
    // subgroup would be exact, but a group operation needs a register predicate
    // and this has none, and the value is used as a shuffle or barrier mask
    // where every lane is active. So it expands to the all-active mask.
    "activemask" ".b32" <dst:ExtendedID> => {
        let details = ast::MovDetails::new(ast::Type::Scalar(ast::ScalarType::B32));
        ast::Instruction::Mov(
            details,
            ast::Arg2Mov {
                dst: ast::Operand::Reg(dst),
                src: ast::Operand::Imm(ast::ImmediateValue::U64(u32::MAX as u64)),
            },
        )
    }
}

// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#parallel-synchronization-and-communication-instructions-bar
InstBar: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "barrier" ".sync" <a:Arg1Bar> => ast::Instruction::Bar(ast::BarDetails::SyncAligned, a),
    "barrier" ".sync" ".aligned" <a:Arg1Bar> => ast::Instruction::Bar(ast::BarDetails::SyncAligned, a),
    "bar" ".sync" <a:Arg1Bar> => ast::Instruction::Bar(ast::BarDetails::SyncAligned, a),
    "bar" ".sync" ".aligned" <a:Arg1Bar> => ast::Instruction::Bar(ast::BarDetails::SyncAligned, a),
    // bar.warp.sync - a barrier that synchronizes only the warp
    "bar" ".warp" ".sync" <a:Arg1Bar> => ast::Instruction::Bar(ast::BarDetails::WarpSync, a),
    // bar.red.popc.u32 %dst, %barrier, %pred - count threads with pred true at barrier
    "bar" ".red" ".popc" ".u32" <dst:Operand> "," <bar_id:Operand> "," <pred:Operand> =>
        ast::Instruction::BarRedPopc(dst, bar_id, pred),
    // bar.red.or.pred %dst, %barrier, %pred - the disjunction (or the
    // conjunction) of a predicate across the workgroup; the flag says
    // "conjunction", false being the disjunction.
    "bar" ".red" ".or" ".pred" <dst:Operand> "," <bar_id:Operand> "," <pred:Operand> =>
        ast::Instruction::BarRedPred(false, dst, bar_id, pred),
    "bar" ".red" ".and" ".pred" <dst:Operand> "," <bar_id:Operand> "," <pred:Operand> =>
        ast::Instruction::BarRedPred(true, dst, bar_id, pred)
}

// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#warp-shuffle-functions
//   shfl.sync.mode.b32 d[|p], a, b, c, membermask;   (c: clamp [4:0], segment mask [12:8])
// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#warp-level-matrix-instructions-ldmatrix
//   ldmatrix.sync.aligned.m8n8.x{1,2,4}{.trans}{.shared}.b16 {d...}, [p];
InstLdMatrix: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "ldmatrix" ".sync" ".aligned" ".m8n8" <num:LdMatrixNum> <trans:".trans"?> <_ss:".shared"?> ".b16" <dst:DstOperandVec> "," <src:MemoryOperand> => {
        ast::Instruction::LdMatrix(
            ast::LdMatrixDetails {
                num,
                trans: trans.is_some(),
            },
            ast::Arg2LdMatrix { dst, src },
        )
    },
};

// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#warp-level-matrix-instructions-movmatrix
//   movmatrix.sync.aligned.m8n8.trans.b16 d, a;
InstMovMatrix: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "movmatrix" ".sync" ".aligned" ".m8n8" ".trans" ".b16" <a:Arg2> => {
        ast::Instruction::MovMatrix(a)
    },
};

// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#data-movement-and-conversion-instructions-cp-async

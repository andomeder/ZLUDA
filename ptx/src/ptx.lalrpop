};

// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#parallel-synchronization-and-communication-instructions-redux-sync
//   redux.sync.add.s32 d, a, membermask;
InstRedux: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "redux" ".sync" ".add" <t:ScalarType> <d:Operand> "," <a:Operand> "," <mask:Operand> =>
        ast::Instruction::Redux(ast::ReduxOp::Add, t, ast::Arg3 { dst: d, src1: a, src2: mask }),
    "redux" ".sync" ".min" <t:ScalarType> <d:Operand> "," <a:Operand> "," <mask:Operand> =>
        ast::Instruction::Redux(ast::ReduxOp::Min, t, ast::Arg3 { dst: d, src1: a, src2: mask }),
    "redux" ".sync" ".max" <t:ScalarType> <d:Operand> "," <a:Operand> "," <mask:Operand> =>
        ast::Instruction::Redux(ast::ReduxOp::Max, t, ast::Arg3 { dst: d, src1: a, src2: mask }),
    "redux" ".sync" ".and" <t:BitType> <d:Operand> "," <a:Operand> "," <mask:Operand> =>
        ast::Instruction::Redux(ast::ReduxOp::And, t, ast::Arg3 { dst: d, src1: a, src2: mask }),
    "redux" ".sync" ".or" <t:BitType> <d:Operand> "," <a:Operand> "," <mask:Operand> =>
        ast::Instruction::Redux(ast::ReduxOp::Or, t, ast::Arg3 { dst: d, src1: a, src2: mask }),
    "redux" ".sync" ".xor" <t:BitType> <d:Operand> "," <a:Operand> "," <mask:Operand> =>
        ast::Instruction::Redux(ast::ReduxOp::Xor, t, ast::Arg3 { dst: d, src1: a, src2: mask }),
};

// The packed forms of the float conversion: two floats, one register.
//   cvt.rn.f16x2.f32 d, a, b;   -> d = { b (low), a (high) }
InstCvtPacked: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "cvt" <rnd:RoundingModeFloat> ".f16x2" ".f32" <d:Operand> "," <a:Operand> "," <b:Operand> => {
        let _ = rnd;
        ast::Instruction::CvtPacked(ast::ScalarType::F16x2, ast::Arg3 { dst: d, src1: a, src2: b })
    },
    "cvt" <rnd:RoundingModeFloat> ".bf16x2" ".f32" <d:Operand> "," <a:Operand> "," <b:Operand> => {
        let _ = rnd;
        ast::Instruction::CvtPacked(ast::ScalarType::B16, ast::Arg3 { dst: d, src1: a, src2: b })
    },
};

// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#control-flow-instructions-brx
//   brx.idx %r, $L_brx_0;      jump to the n-th label of the table
InstBrxIdx: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "brx" ".idx" <index:Operand> "," <table:ExtendedID> => {
        // The table is resolved to its labels when the identifiers of the
        // function are resolved; the target list is filled in there.
        ast::Instruction::BrxIdx(index, Some(ast::Operand::Reg(table)), Vec::new())
    },
};

// https://docs.nvidia.com/cuda/parallel-tensor-thread-execution -- see
// "Video Instructions". Four bytes are operated on in parallel:
//   vsub4.u32.u32.u32 d, a, b, c;    per byte: a - b, wrapped into the byte
//   vset4.u32.u32.ne  d, a, b, c;    per byte: a != b, one or zero
// The fourth operand is the secondary operand of the general form, unused
// by the forms the compiler emits.
InstVSub4: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "vsub4" ".u32" ".u32" ".u32" <a:Arg4> => ast::Instruction::VSub4(ast::Arg3 {
        dst: a.dst,
        src1: a.src1,
        src2: a.src2,
    }),
};

InstVSet4: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "vset4" ".u32" ".u32" ".eq" <a:Arg4> => ast::Instruction::VSet4(ast::CompareOp::Eq, ast::Arg3 {
        dst: a.dst,
        src1: a.src1,
        src2: a.src2,
    }),
    "vset4" ".u32" ".u32" ".ne" <a:Arg4> => ast::Instruction::VSet4(ast::CompareOp::Ne, ast::Arg3 {
        dst: a.dst,
        src1: a.src1,
        src2: a.src2,
    }),
    "vset4" ".u32" ".u32" ".lt" <a:Arg4> => ast::Instruction::VSet4(ast::CompareOp::Lt, ast::Arg3 {
        dst: a.dst,
        src1: a.src1,
        src2: a.src2,
    }),
    "vset4" ".u32" ".u32" ".le" <a:Arg4> => ast::Instruction::VSet4(ast::CompareOp::Le, ast::Arg3 {
        dst: a.dst,
        src1: a.src1,
        src2: a.src2,
    }),
    "vset4" ".u32" ".u32" ".gt" <a:Arg4> => ast::Instruction::VSet4(ast::CompareOp::Gt, ast::Arg3 {
        dst: a.dst,
        src1: a.src1,
        src2: a.src2,
    }),
    "vset4" ".u32" ".u32" ".ge" <a:Arg4> => ast::Instruction::VSet4(ast::CompareOp::Ge, ast::Arg3 {
        dst: a.dst,
        src1: a.src1,
        src2: a.src2,
    }),
};

InstNanosleep: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "nanosleep" ".u32" <a:Arg1> => ast::Instruction::Nanosleep(a)
};

// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#floating-point-instructions-copysign
// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#data-movement-and-conversion-instructions-shf
//   shf.l.wrap.b32 d, a, b, c;   d = (b << c) | (a >> (32 - c))
//   shf.r.wrap.b32 d, a, b, c;   d = (a >> c) | (b << (32 - c))
// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#warp-level-matrix-instructions-mma
//   mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
//       {d0,d1,d2,d3}, {a0,a1,a2,a3}, {b0,b1}, {c0,c1,c2,c3};
InstMma: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "mma" ".sync" ".aligned" <shape:MmaShape> <_l1:MmaLayout> <_l2:MmaLayout> <dst:MmaType> <a:MmaType> <b:MmaType> <c:MmaType> <d:DstOperandVec> "," <fa:SrcOperandVec> "," <fb:SrcOperandVec> "," <fc:SrcOperandVec> => {
        let (m, n, k) = shape;
        ast::Instruction::Mma(
            ast::MmaDetails { m, n, k, dst, a, b, c },
            ast::ArgMma { dst: d, a: fa, b: fb, c: fc },
        )
    },
};

MmaShape: (u8, u8, u8) = {
    ".m16n8k8" => (16, 8, 8),
    ".m16n8k16" => (16, 8, 16),
    ".m16n8k32" => (16, 8, 32),
};

MmaLayout: () = {
    ".row" => (),
    ".col" => (),
};

// The type names of the mma form don't carry the leading dot in the
// nonterminal, so the grammar can name them individually.
MmaType: ast::ScalarType = {
    ".f16" => ast::ScalarType::F16,
    ".bf16" => ast::ScalarType::B16,
    ".f32" => ast::ScalarType::F32,
    ".s32" => ast::ScalarType::S32,
    ".u32" => ast::ScalarType::U32,
    ".s8" => ast::ScalarType::S8,
    ".u8" => ast::ScalarType::U8,
    ".tf32" => ast::ScalarType::B32,
};

InstShf: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "shf" ".l" ".wrap" ".b32" <a:Arg4> => ast::Instruction::Shf(ast::ShfDetails { left: true, wrap: true }, a),
    "shf" ".l" ".clamp" ".b32" <a:Arg4> => ast::Instruction::Shf(ast::ShfDetails { left: true, wrap: false }, a),
    "shf" ".r" ".wrap" ".b32" <a:Arg4> => ast::Instruction::Shf(ast::ShfDetails { left: false, wrap: true }, a),
    "shf" ".r" ".clamp" ".b32" <a:Arg4> => ast::Instruction::Shf(ast::ShfDetails { left: false, wrap: false }, a),
};

InstTrap: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "trap" => ast::Instruction::Trap
};

InstCopysign: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "copysign" ".f32" <a:Arg3> => ast::Instruction::Copysign(ast::ScalarType::F32, a)
};

// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#integer-arithmetic-instructions-dp4a
InstDp4a: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "dp4a" ".s32" ".s32" <a:Arg4> => ast::Instruction::Dp4a(ast::ScalarType::S32, a),
    "dp4a" ".u32" ".u32" <a:Arg4> => ast::Instruction::Dp4a(ast::ScalarType::U32, a),
};

// The cache operator of a cp.async: it only selects the cache level the copy
// goes through.
CpAsyncCacheOp: () = {
    ".ca" => (),
    ".cg" => (),
};

InstCpAsync: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "cp" ".async" <_cache:CpAsyncCacheOp?> ".shared" ".global" "[" <dst:Operand> "]" "," "[" <src:Operand> "]" "," <size:DecimalNumToken> <src_size:("," <Operand>)?> => {
        ast::Instruction::CpAsync(
            ast::CpAsyncDetails { size: size.parse().unwrap_or(0) },
            ast::ArgCpAsync { dst, src, src_size },
        )
    },
    "cp" ".async" ".commit_group" => ast::Instruction::CpAsyncCommitGroup,
    "cp" ".async" ".wait_group" <n:DecimalNumToken> => ast::Instruction::CpAsyncWaitGroup(n.parse().unwrap_or(0)),
    "cp" ".async" ".wait_all" => ast::Instruction::CpAsyncWaitAll,
};

LdMatrixNum: u8 = {
    ".x1" => 1,
    ".x2" => 2,
    ".x4" => 4,
};

InstShfl: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "shfl" ".sync" ".idx" ".b32" <dst:Operand> <pred:OptionalDstOperand?> "," <src:Operand> "," <lane:Operand> "," <clamp:Operand> "," <mask:Operand> =>
        ast::Instruction::Shfl(ast::ShflMode::Idx, ast::ScalarType::B32, ast::ArgShfl { dst, dst_predicate: pred, src, lane, clamp, member_mask: mask }),
    "shfl" ".sync" ".idx" ".u32" <dst:Operand> <pred:OptionalDstOperand?> "," <src:Operand> "," <lane:Operand> "," <clamp:Operand> "," <mask:Operand> =>
        ast::Instruction::Shfl(ast::ShflMode::Idx, ast::ScalarType::U32, ast::ArgShfl { dst, dst_predicate: pred, src, lane, clamp, member_mask: mask }),
    "shfl" ".sync" ".up" ".b32" <dst:Operand> <pred:OptionalDstOperand?> "," <src:Operand> "," <lane:Operand> "," <clamp:Operand> "," <mask:Operand> =>
        ast::Instruction::Shfl(ast::ShflMode::Up, ast::ScalarType::B32, ast::ArgShfl { dst, dst_predicate: pred, src, lane, clamp, member_mask: mask }),
    "shfl" ".sync" ".up" ".u32" <dst:Operand> <pred:OptionalDstOperand?> "," <src:Operand> "," <lane:Operand> "," <clamp:Operand> "," <mask:Operand> =>
        ast::Instruction::Shfl(ast::ShflMode::Up, ast::ScalarType::U32, ast::ArgShfl { dst, dst_predicate: pred, src, lane, clamp, member_mask: mask }),
    "shfl" ".sync" ".down" ".b32" <dst:Operand> <pred:OptionalDstOperand?> "," <src:Operand> "," <lane:Operand> "," <clamp:Operand> "," <mask:Operand> =>
        ast::Instruction::Shfl(ast::ShflMode::Down, ast::ScalarType::B32, ast::ArgShfl { dst, dst_predicate: pred, src, lane, clamp, member_mask: mask }),
    "shfl" ".sync" ".down" ".u32" <dst:Operand> <pred:OptionalDstOperand?> "," <src:Operand> "," <lane:Operand> "," <clamp:Operand> "," <mask:Operand> =>
        ast::Instruction::Shfl(ast::ShflMode::Down, ast::ScalarType::U32, ast::ArgShfl { dst, dst_predicate: pred, src, lane, clamp, member_mask: mask }),
    "shfl" ".sync" ".bfly" ".b32" <dst:Operand> <pred:OptionalDstOperand?> "," <src:Operand> "," <lane:Operand> "," <clamp:Operand> "," <mask:Operand> =>
        ast::Instruction::Shfl(ast::ShflMode::Bfly, ast::ScalarType::B32, ast::ArgShfl { dst, dst_predicate: pred, src, lane, clamp, member_mask: mask }),
    "shfl" ".sync" ".bfly" ".u32" <dst:Operand> <pred:OptionalDstOperand?> "," <src:Operand> "," <lane:Operand> "," <clamp:Operand> "," <mask:Operand> =>
        ast::Instruction::Shfl(ast::ShflMode::Bfly, ast::ScalarType::U32, ast::ArgShfl { dst, dst_predicate: pred, src, lane, clamp, member_mask: mask }),
}

// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#warp-vote-functions
//   vote.sync.mode.pred   d, a, membermask;   // d and a are predicates
//   vote.sync.ballot.b32 d, a, membermask;   // d is the bitmask
// .mode = { .all, .any, .uni }
InstVote: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "vote" ".sync" ".all" ".pred" <dst:Operand> "," <src:Operand> "," <mask:Operand> =>
        ast::Instruction::Vote(ast::VoteMode::All, ast::ScalarType::Pred, ast::ArgVote { dst, src, member_mask: mask }),
    "vote" ".sync" ".any" ".pred" <dst:Operand> "," <src:Operand> "," <mask:Operand> =>
        ast::Instruction::Vote(ast::VoteMode::Any, ast::ScalarType::Pred, ast::ArgVote { dst, src, member_mask: mask }),
    "vote" ".sync" ".uni" ".pred" <dst:Operand> "," <src:Operand> "," <mask:Operand> =>
        ast::Instruction::Vote(ast::VoteMode::Uni, ast::ScalarType::Pred, ast::ArgVote { dst, src, member_mask: mask }),
    "vote" ".sync" ".ballot" ".b32" <dst:Operand> "," <src:Operand> "," <mask:Operand> =>
        ast::Instruction::Vote(ast::VoteMode::Ballot, ast::ScalarType::B32, ast::ArgVote { dst, src, member_mask: mask }),
    // The ISA also spells the vote with the operation before the barrier:
    // "vote.ballot.sync.b32 d, p, mask;"
    "vote" ".all" ".sync" ".pred" <dst:Operand> "," <src:Operand> "," <mask:Operand> =>
        ast::Instruction::Vote(ast::VoteMode::All, ast::ScalarType::Pred, ast::ArgVote { dst, src, member_mask: mask }),
    "vote" ".any" ".sync" ".pred" <dst:Operand> "," <src:Operand> "," <mask:Operand> =>
        ast::Instruction::Vote(ast::VoteMode::Any, ast::ScalarType::Pred, ast::ArgVote { dst, src, member_mask: mask }),
    "vote" ".uni" ".sync" ".pred" <dst:Operand> "," <src:Operand> "," <mask:Operand> =>
        ast::Instruction::Vote(ast::VoteMode::Uni, ast::ScalarType::Pred, ast::ArgVote { dst, src, member_mask: mask }),
    "vote" ".ballot" ".sync" ".b32" <dst:Operand> "," <src:Operand> "," <mask:Operand> =>
        ast::Instruction::Vote(ast::VoteMode::Ballot, ast::ScalarType::B32, ast::ArgVote { dst, src, member_mask: mask }),
}

// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#parallel-synchronization-and-communication-instructions-atom
// The documentation does not mention all spported operations:
// * Operation .add requires .u32 or .s32 or .u64 or .f64 or f16 or f16x2 or .f32
// * Operation .inc requires .u32 type for instuction
// * Operation .dec requires .u32 type for instuction
// Otherwise as documented
InstAtom: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "red" <sema:AtomSemantics?> <scope:MemScope?> <space:AtomSpace?> <op:AtomBitOp> <typ:BitType> <src1:MemoryOperand> "," <src2:SrcOperandVec> => {
        let details = ast::AtomDetails {
            semantics: sema.unwrap_or(ast::AtomSemantics::Relaxed),
            scope: scope.unwrap_or(ast::MemScope::Gpu),
            space: space.unwrap_or(ast::StateSpace::Generic),
            inner: ast::AtomInnerDetails::Bit { op, typ }
        };
        ast::Instruction::Red(details, ast::Arg2St { src1, src2 })
    },
    "red" <sema:AtomSemantics?> <scope:MemScope?> <space:AtomSpace?> ".add" <typ:FloatType> <src1:MemoryOperand> "," <src2:SrcOperandVec> => {
        let op = ast::AtomFloatOp::Add;
        let details = ast::AtomDetails {
            semantics: sema.unwrap_or(ast::AtomSemantics::Relaxed),
            scope: scope.unwrap_or(ast::MemScope::Gpu),
            space: space.unwrap_or(ast::StateSpace::Generic),
            inner: ast::AtomInnerDetails::Float { op, typ }
        };
        ast::Instruction::Red(details, ast::Arg2St { src1, src2 })
    },
    "red" <op: AtomUIntOp> <sema:AtomSemantics> <scope:MemScope?> <space:AtomSpace?> <typ:UIntType3264> <src1:MemoryOperand> "," <src2:SrcOperandVec> => {
        let details = ast::AtomDetails {
            semantics: sema,
            scope: scope.unwrap_or(ast::MemScope::Gpu),
            space: space.unwrap_or(ast::StateSpace::Generic),
            inner: ast::AtomInnerDetails::Unsigned { op, typ }
        };
        ast::Instruction::Red(details, ast::Arg2St { src1, src2 })
    },
    "red" <sema:AtomSemantics?> <scope:MemScope?> <space:AtomSpace?> <op: AtomUIntOp> <typ:UIntType3264> <src1:MemoryOperand> "," <src2:SrcOperandVec> => {
        let details = ast::AtomDetails {
            semantics: sema.unwrap_or(ast::AtomSemantics::Relaxed),
            scope: scope.unwrap_or(ast::MemScope::Gpu),
            space: space.unwrap_or(ast::StateSpace::Generic),
            inner: ast::AtomInnerDetails::Unsigned { op, typ }
        };
        ast::Instruction::Red(details, ast::Arg2St { src1, src2 })
    },
    "atom" <sema:AtomSemantics?> <scope:MemScope?> <space:AtomSpace?> <op:AtomBitOp> <typ:BitType> <a:Arg3Atom> => {
        let details = ast::AtomDetails {
            semantics: sema.unwrap_or(ast::AtomSemantics::Relaxed),
            scope: scope.unwrap_or(ast::MemScope::Gpu),
            space: space.unwrap_or(ast::StateSpace::Generic),
            inner: ast::AtomInnerDetails::Bit { op, typ }
        };
        ast::Instruction::Atom(details,a)
    },
    "atom" <sema:AtomSemantics?> <scope:MemScope?> <space:AtomSpace?> ".inc" ".u32" <a:Arg3Atom> => {
        let details = ast::AtomDetails {
            semantics: sema.unwrap_or(ast::AtomSemantics::Relaxed),
            scope: scope.unwrap_or(ast::MemScope::Gpu),
            space: space.unwrap_or(ast::StateSpace::Generic),
            inner: ast::AtomInnerDetails::Unsigned {
                op: ast::AtomUIntOp::Inc,
                typ: ast::ScalarType::U32
            }
        };
        ast::Instruction::Atom(details,a)
    },
    "atom" <sema:AtomSemantics?> <scope:MemScope?> <space:AtomSpace?> ".dec" ".u32" <a:Arg3Atom> => {
        let details = ast::AtomDetails {
            semantics: sema.unwrap_or(ast::AtomSemantics::Relaxed),
            scope: scope.unwrap_or(ast::MemScope::Gpu),
            space: space.unwrap_or(ast::StateSpace::Generic),
            inner: ast::AtomInnerDetails::Unsigned {
                op: ast::AtomUIntOp::Dec,
                typ: ast::ScalarType::U32
            }
        };
        ast::Instruction::Atom(details,a)
    },
    "atom" <sema:AtomSemantics?> <scope:MemScope?> <space:AtomSpace?> ".add" <typ:FloatType> <a:Arg3Atom> => {
        let op = ast::AtomFloatOp::Add;
        let details = ast::AtomDetails {
            semantics: sema.unwrap_or(ast::AtomSemantics::Relaxed),
            scope: scope.unwrap_or(ast::MemScope::Gpu),
            space: space.unwrap_or(ast::StateSpace::Generic),
            inner: ast::AtomInnerDetails::Float { op, typ }
        };
        ast::Instruction::Atom(details,a)
    },
    "atom" <op: AtomUIntOp> <sema:AtomSemantics> <scope:MemScope?> <space:AtomSpace?> <typ:UIntType3264> <a:Arg3Atom> => {
        let details = ast::AtomDetails {
            semantics: sema,
            scope: scope.unwrap_or(ast::MemScope::Gpu),
            space: space.unwrap_or(ast::StateSpace::Generic),
            inner: ast::AtomInnerDetails::Unsigned { op, typ }
        };
        ast::Instruction::Atom(details,a)
    },
    "atom" <sema:AtomSemantics?> <scope:MemScope?> <space:AtomSpace?> <op: AtomUIntOp> <typ:UIntType3264> <a:Arg3Atom> => {
        let details = ast::AtomDetails {
            semantics: sema.unwrap_or(ast::AtomSemantics::Relaxed),
            scope: scope.unwrap_or(ast::MemScope::Gpu),
            space: space.unwrap_or(ast::StateSpace::Generic),
            inner: ast::AtomInnerDetails::Unsigned { op, typ }
        };
        ast::Instruction::Atom(details,a)
    },
    "atom" <sema:AtomSemantics?> <scope:MemScope?> <space:AtomSpace?> <op: AtomSIntOp> <typ:SIntType3264> <a:Arg3Atom> => {
        let details = ast::AtomDetails {
            semantics: sema.unwrap_or(ast::AtomSemantics::Relaxed),
            scope: scope.unwrap_or(ast::MemScope::Gpu),
            space: space.unwrap_or(ast::StateSpace::Generic),
            inner: ast::AtomInnerDetails::Signed { op, typ }
        };
        ast::Instruction::Atom(details,a)
    }
}


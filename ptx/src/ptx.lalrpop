// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#integer-arithmetic-instructions-mad
// https://docs.nvidia.com/cuda/parallel-thread-execution/index.html#floating-point-instructions-mad
InstMad: ast::Instruction<ast::ParsedArgParams<'input>> = {
    "mad" <d:MulDetails> <a:Arg4> => ast::Instruction::Mad(d, a),
    // ".cc" writes the carry-out to a predicate; without a predicate
    // destination the carry is not observable.
    "mad" ".lo" ".cc" <t:SignedIntType> <a:Arg4> =>
        ast::Instruction::Mad(ast::MulDetails::Signed(ast::MulSInt { typ: t, control: ast::MulIntControl::Low }), a),
    "mad" ".lo" ".cc" <t:UIntType> <a:Arg4> =>
        ast::Instruction::Mad(ast::MulDetails::Unsigned(ast::MulUInt { typ: t, control: ast::MulIntControl::Low }), a),
    "mad" ".hi" ".sat" ".s32" => todo!(),
    "madc" ".lo" <t:UIntType> <a:Arg4> =>
        ast::Instruction::Mad(ast::MulDetails::Unsigned(ast::MulUInt { typ: t, control: ast::MulIntControl::Low }), a),
    "madc" ".hi" <t:UIntType> <a:Arg4> =>
        ast::Instruction::Mad(ast::MulDetails::Unsigned(ast::MulUInt { typ: t, control: ast::MulIntControl::High }), a),
    "madc" ".wide" <t:UIntType> <a:Arg4> =>
        ast::Instruction::Mad(ast::MulDetails::Unsigned(ast::MulUInt { typ: t, control: ast::MulIntControl::Wide }), a),
    "madc" ".lo" <t:SIntType> <a:Arg4> =>
        ast::Instruction::Mad(ast::MulDetails::Signed(ast::MulSInt { typ: t, control: ast::MulIntControl::Low }), a),
    "madc" ".hi" <t:SIntType> <a:Arg4> =>
        ast::Instruction::Mad(ast::MulDetails::Signed(ast::MulSInt { typ: t, control: ast::MulIntControl::High }), a),
    "madc" ".wide" <t:SIntType> <a:Arg4> =>
        ast::Instruction::Mad(ast::MulDetails::Signed(ast::MulSInt { typ: t, control: ast::MulIntControl::Wide }), a),
    "fma" <f:ArithFloatMustRound> <a:Arg4> => ast::Instruction::Mad(ast::MulDetails::Float(f), a),
};

SignedIntType: ast::ScalarType = {
    ".s16" => ast::ScalarType::S16,
    ".s32" => ast::ScalarType::S32,
    ".s64" => ast::ScalarType::S64,
};


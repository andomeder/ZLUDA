         %19 = OpLoad %uint %7
         %35 = OpBitcast %float %19
         %56 = OpConvertFToS %uint %35
         %34 = OpCopyObject %uint %56
         %18 = OpCopyObject %uint %34
               OpStore %7 %18
         %20 = OpLoad %ulong %5
         %21 = OpLoad %uint %6
         %36 = OpConvertUToPtr %_ptr_CrossWorkgroup_uint %20
         %37 = OpCopyObject %uint %21
               OpStore %36 %37 Aligned 4
         %22 = OpLoad %ulong %5
         %23 = OpLoad %uint %7

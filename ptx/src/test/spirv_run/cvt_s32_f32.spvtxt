         %59 = OpBitcast %_ptr_CrossWorkgroup_uchar %38
         %60 = OpInBoundsPtrAccessChain %_ptr_CrossWorkgroup_uchar %59 %ulong_4_0
         %27 = OpBitcast %_ptr_CrossWorkgroup_uint %60

         %53 = OpBitcast %_ptr_Generic_uchar %30
         %54 = OpInBoundsPtrAccessChain %_ptr_Generic_uchar %53 %ulong_4
         %25 = OpBitcast %_ptr_Generic_float %54
         %31 = OpLoad %float %25 Aligned 4
         %14 = OpBitcast %uint %31
               OpStore %7 %14

.version 7.0
.target sm_80
.address_size 64
.visible .entry ctaid2d(
    .param .u64 out
)
{
    .reg .u32 %r<8>;
    .reg .u64 %rd<10>;
    ld.param.u64 %rd1, [out];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ctaid.y;
    mul.lo.s32 %r3, %r2, 64;
    mul.lo.s32 %r4, %r1, 8;
    add.s32 %r5, %r3, %r4;
    cvt.u64.s32 %rd4, %r5;
    add.s64 %rd5, %rd1, %rd4;
    st.global.u32 [%rd5], %r1;
    mov.u64 %rd6, 4;
    add.s64 %rd7, %rd5, %rd6;
    st.global.u32 [%rd7], %r2;
    ret;
}

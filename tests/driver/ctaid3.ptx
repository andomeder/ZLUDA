.version 7.0
.target sm_80
.address_size 64
.visible .entry ctaid3(
    .param .u64 out
)
{
    .reg .u32 %r<8>;
    .reg .u64 %rd<10>;
    ld.param.u64 %rd1, [out];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %ctaid.x;
    /* store raw ctaid.x at offset 0 */
    st.global.u32 [%rd1], %r1;
    ret;
}

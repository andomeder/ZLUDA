.version 7.0
.target sm_80
.address_size 64
.visible .entry ctaid7(
    .param .u64 out
)
{
    .reg .u32 %r<8>;
    .reg .u64 %rd<10>;
    ld.param.u64 %rd1, [out];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %ctaid.x;
    /* store raw ctaid.x at offset 0 */
    st.global.u32 [%rd1], %r1;
    /* store ctaid.x * 32 at offset 4 as u64 */
    mul.wide.s32 %rd2, %r1, 32;
    mov.u64 %rd3, 4;
    add.s64 %rd4, %rd1, %rd3;
    st.global.u64 [%rd4], %rd2;
    ret;
}

.version 7.0
.target sm_80
.address_size 64
.visible .entry ctaidrace(
    .param .u64 out
)
{
    .reg .u32 %r<8>;
    .reg .u64 %rd<10>;
    ld.param.u64 %rd1, [out];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ctaid.y;
    st.global.u32 [%rd1], %r1;
    mov.u64 %rd2, 4;
    add.s64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r2;
    ret;
}

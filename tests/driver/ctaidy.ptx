.version 7.0
.target sm_80
.address_size 64
.visible .entry ctaidy(
    .param .u64 out
)
{
    .reg .u32 %r<8>;
    .reg .u64 %rd<10>;
    ld.param.u64 %rd1, [out];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %ctaid.y;
    /* out[blockIdx.y] = blockIdx.y */
    mul.wide.u32 %rd2, %r1, 4;
    add.s64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r1;
    ret;
}
